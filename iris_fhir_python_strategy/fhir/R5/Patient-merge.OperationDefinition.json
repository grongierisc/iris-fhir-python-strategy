{
  "resourceType": "OperationDefinition",
  "id": "Patient-merge",
  "url": "http://hl7.org/fhir/OperationDefinition/Patient-merge",
  "version": "5.0.0",
  "name": "Merge",
  "title": "Merge Patients",
  "status": "active",
  "kind": "operation",
  "description": "Published R5 Patient $merge contract with synchronous transactional writes and an inactive retained source. Discovery uses native Patient $everything; references outside that scope may remain unchanged. Unsupported discovered references and oversized merges are rejected before writing. No custom merge lock or concurrent-write isolation guarantee.",
  "affectsState": true,
  "code": "merge",
  "resource": ["Patient"],
  "system": false,
  "type": true,
  "instance": false,
  "parameter": [
    {"name": "source-patient", "use": "in", "min": 0, "max": "1", "type": "Reference", "targetProfile": ["http://hl7.org/fhir/StructureDefinition/Patient"]},
    {"name": "source-patient-identifier", "use": "in", "min": 0, "max": "*", "type": "Identifier"},
    {"name": "target-patient", "use": "in", "min": 0, "max": "1", "type": "Reference", "targetProfile": ["http://hl7.org/fhir/StructureDefinition/Patient"]},
    {"name": "target-patient-identifier", "use": "in", "min": 0, "max": "*", "type": "Identifier"},
    {"name": "result-patient", "use": "in", "min": 0, "max": "1", "type": "Patient"},
    {"name": "preview", "use": "in", "min": 0, "max": "1", "type": "boolean"},
    {"name": "return", "use": "out", "min": 1, "max": "1", "type": "Parameters"}
  ]
}
