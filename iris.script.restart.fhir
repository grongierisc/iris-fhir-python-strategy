
    zn "FHIRSERVER"

    set sc=$system.OBJ.LoadDir("/irisdev/app/iris_fhir_python_strategy/cls", "ck", , 1)
    if $system.Status.IsError(sc) { do $system.Status.DisplayError(sc) halt }
    try { do ##class(FHIR.Python.Setup).PublishDefinition("/fhir/r4") write !,"FHIR RESTART OK",! } catch ex { do $system.Status.DisplayError(ex.AsStatus()) }

    halt 
